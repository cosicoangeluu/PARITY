# Copy to .env.local for local development, and add the same values in Vercel → Settings →
# Environment Variables. Everything here is on a free plan; none of it needs a credit card.

# Supabase (free plan) → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# The publishable (anon) key. Safe in the browser: Row Level Security blocks it from all tables.
# Only used to listen for live updates (Realtime broadcast).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The secret (service_role) key. SERVER ONLY. Never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Public address of the app, used in share links and QR codes.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Receipt reading. Both optional: without them the phone reads receipts with Tesseract.js.
# Google AI Studio → Get API key (free tier, Flash-Lite)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
# https://ocr.space/ocrapi/freekey (25,000 requests a month, 500 a day)
OCR_SPACE_API_KEY=
# Protects the free reading quota.
DAILY_SCAN_LIMIT_PER_GROUP=30

# Cloudflare Turnstile (free bot check on "Start a group"). Optional; skipped when empty.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Any long random string. The daily GitHub Action sends it to /api/cron.
CRON_SECRET=
